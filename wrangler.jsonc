{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutin-learning",
  "account_id": "1429363309ae69d8c5bfe5dbea7a79cd",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "GOOGLE_OAUTH_CLIENT_ID": "175015546102-a4pluug69ph7haeki986590hghcj1ho3.apps.googleusercontent.com"
  },
  "routes": [
    { "pattern": "udemy.chaigallery.in", "zone_name": "chaigallery.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
