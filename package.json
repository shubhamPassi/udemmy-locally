{
  "name": "tutin",
  "version": "4.0.0",
  "description": "AI-Powered Course Learning Platform",
  "author": "noor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noureldenadel/TutIn.git"
  },
  "keywords": [
    "course-management",
    "video-player",
    "ai-transcription",
    "learning-platform",
    "offline-first",
    "react",
    "vite"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron .",
    "icons": "node scripts/generate-icons.mjs",
    "dist:win": "npm run build && npm run icons && electron-builder --win portable",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.tutin.app",
    "productName": "TutIn",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/tutin-icon.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TutIn.exe"
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.469.0",
    "mpegts.js": "^1.8.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "sql.js": "^1.14.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.1",
    "vite": "^6.0.5"
  }
}
